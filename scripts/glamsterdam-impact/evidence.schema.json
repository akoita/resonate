{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.resonate.invalid/glamsterdam-repricing-evidence-v1.json",
  "title": "Resonate Glamsterdam repricing evidence",
  "description": "Sanitized receipt-backed or eth_simulateV1 local characterization evidence. RPC endpoints and credentials are intentionally not representable. A receipt estimate below gasUsed is a harmful underestimation; higher estimates are valid headroom. The unchanged classification requires an explicit baseline/candidate comparison.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "generatedAt", "repo", "chain", "contracts", "observations"],
  "properties": {
    "schemaVersion": { "const": "resonate-glamsterdam-repricing-evidence/v1" },
    "generatedAt": { "type": "string", "format": "date-time" },
    "repo": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sha", "date", "specRevision"],
      "properties": {
        "sha": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "date": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
        "specRevision": { "type": "string", "minLength": 1, "maxLength": 128 }
      }
    },
    "chain": { "$ref": "#/$defs/chain" },
    "contracts": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/contract" }
    },
    "observations": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/observation" }
    }
  },
  "$defs": {
    "chain": {
      "type": "object",
      "additionalProperties": false,
      "required": ["chainId", "network", "blockNumber", "rpcIdentifier"],
      "properties": {
        "chainId": { "type": "integer", "minimum": 1 },
        "network": { "type": "string", "minLength": 1, "maxLength": 64 },
        "blockNumber": { "type": "integer", "minimum": 0 },
        "rpcIdentifier": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$" }
      }
    },
    "contract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["role", "address"],
      "properties": {
        "role": { "type": "string", "minLength": 1, "maxLength": 128 },
        "address": { "type": "string", "pattern": "^0x[0-9a-fA-F]{40}$" }
      }
    },
    "receipt": {
      "description": "A mined receipt. status 0 is an execution failure; gasUsed is the actual consumed gas.",
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["txHash", "status", "gasUsed", "blockNumber"],
      "properties": {
        "txHash": { "type": "string", "pattern": "^0x[0-9a-fA-F]{64}$" },
        "status": { "type": "integer", "enum": [0, 1] },
        "gasUsed": { "type": "integer", "minimum": 1 },
        "blockNumber": { "type": "integer", "minimum": 0 }
      }
    },
    "direct": {
      "type": "object",
      "additionalProperties": false,
      "required": ["estimateGas", "receipt"],
      "properties": {
        "estimateGas": { "description": "A target-chain estimate. Values below receipt gasUsed are harmful underestimates; values above gasUsed are normal headroom.", "type": ["integer", "null"], "minimum": 1 },
        "receipt": { "$ref": "#/$defs/receipt" }
      }
    },
    "simulation": {
      "description": "A deterministic Geth multi-block simulation result for a time- or state-dependent path that cannot be mined during the bounded local run.",
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["method", "status", "gasUsed", "blockNumber", "timestamp"],
      "properties": {
        "method": { "const": "eth_simulateV1" },
        "status": { "type": "integer", "enum": [0, 1] },
        "gasUsed": { "type": "integer", "minimum": 1 },
        "blockNumber": { "type": "integer", "minimum": 0 },
        "timestamp": { "type": "integer", "minimum": 1 }
      }
    },
    "userOperation": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["estimateGas", "hash", "txHash", "receipt"],
      "properties": {
        "estimateGas": { "description": "A target-chain UserOperation estimate. Values below receipt gasUsed are harmful underestimates; values above gasUsed are normal headroom.", "type": ["integer", "null"], "minimum": 1 },
        "hash": { "type": ["string", "null"], "pattern": "^0x[0-9a-fA-F]{64}$" },
        "txHash": { "type": ["string", "null"], "pattern": "^0x[0-9a-fA-F]{64}$" },
        "receipt": { "$ref": "#/$defs/receipt" }
      }
    },
    "comparisonRun": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "gasUsed"],
      "properties": {
        "status": { "type": "integer", "enum": [0, 1] },
        "gasUsed": { "type": "integer", "minimum": 1 }
      }
    },
    "comparison": {
      "description": "Baseline-versus-candidate lifecycle evidence required for unchanged. Both status and gasUsed must match; this is not inferred from one target-chain estimate/receipt pair.",
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["baseline", "candidate"],
      "properties": {
        "baseline": { "$ref": "#/$defs/comparisonRun" },
        "candidate": { "$ref": "#/$defs/comparisonRun" }
      }
    },
    "observation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "flow",
        "stateVariant",
        "contractRole",
        "contractAddress",
        "direct",
        "userOperation",
        "txHash",
        "comparison",
        "classification",
        "rpcIdentifier",
        "notes",
        "blocker"
      ],
      "properties": {
        "flow": { "type": "string", "minLength": 1, "maxLength": 128 },
        "stateVariant": { "type": "string", "minLength": 1, "maxLength": 128 },
        "contractRole": { "type": "string", "minLength": 1, "maxLength": 128 },
        "contractAddress": { "type": "string", "pattern": "^0x[0-9a-fA-F]{40}$" },
        "direct": { "$ref": "#/$defs/direct" },
        "simulation": { "$ref": "#/$defs/simulation" },
        "userOperation": { "$ref": "#/$defs/userOperation" },
        "txHash": { "type": ["string", "null"], "pattern": "^0x[0-9a-fA-F]{64}$" },
        "comparison": { "$ref": "#/$defs/comparison" },
        "classification": {
          "description": "unchanged requires explicit baseline/candidate evidence. estimate_mismatch is reserved for harmful underestimation (estimateGas < receipt gasUsed). Successful receipt or simulation observations use succeeds_with_repriced_gas until a durable cross-run comparison is supplied.",
          "type": "string",
          "enum": [
            "unchanged",
            "succeeds_with_repriced_gas",
            "estimate_mismatch",
            "execution_failure",
            "not_applicable",
            "blocked"
          ]
        },
        "rpcIdentifier": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$" },
        "notes": { "type": "string", "minLength": 1, "maxLength": 2000 },
        "blocker": { "type": ["string", "null"], "maxLength": 1000 }
      }
    }
  }
}
