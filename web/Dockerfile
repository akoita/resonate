# ---- Stage 1: Dependencies ----
FROM node:24-alpine@sha256:d32cdf619f63fe0471182d08996dd516c6275bb5fd31ae06e55a570bd9e1ad43 AS deps
WORKDIR /app

COPY package.json package-lock.json .npmrc ./
RUN npm install -g npm@11.14.1
RUN npm ci --ignore-scripts --legacy-peer-deps && \
    for package in \
      node_modules/esbuild \
      node_modules/fsevents \
      node_modules/sharp \
      node_modules/unrs-resolver \
      node_modules/vite/node_modules/fsevents; do \
      if [ -f "${package}/package.json" ]; then \
        npm rebuild --offline --ignore-scripts=false --foreground-scripts -- "file:./${package}"; \
      fi; \
    done

# ---- Stage 2: Build ----
FROM node:24-alpine@sha256:d32cdf619f63fe0471182d08996dd516c6275bb5fd31ae06e55a570bd9e1ad43 AS build
WORKDIR /app

COPY --from=deps /app/node_modules ./node_modules
COPY . .

# Build-time args for NEXT_PUBLIC_* (baked into the JS bundle at compile time)
ARG NEXT_PUBLIC_ZERODEV_PROJECT_ID=""
ARG NEXT_PUBLIC_API_URL=""
ARG NEXT_PUBLIC_CHAIN_ID="11155111"
ARG NEXT_PUBLIC_EXPLORER_URL=""
ARG NEXT_PUBLIC_STEM_NFT_ADDRESS=""
ARG NEXT_PUBLIC_MARKETPLACE_ADDRESS=""
ARG NEXT_PUBLIC_TRANSFER_VALIDATOR_ADDRESS=""
ARG NEXT_PUBLIC_CONTENT_PROTECTION_ADDRESS=""
ARG NEXT_PUBLIC_DISPUTE_RESOLUTION_ADDRESS=""
ARG NEXT_PUBLIC_CURATION_REWARDS_ADDRESS=""
ARG NEXT_PUBLIC_SHOW_CAMPAIGN_ESCROW_ADDRESS=""
ARG NEXT_PUBLIC_RPC_URL=""
ARG NEXT_PUBLIC_AA_BUNDLER=""
ARG NEXT_PUBLIC_PIMLICO_API_KEY=""
ARG NEXT_PUBLIC_PASSKEY_SERVER_URL=""
ARG NEXT_PUBLIC_PASSKEY_RP_ID=""
ARG NEXT_PUBLIC_ENV=""
ARG NEXT_PUBLIC_SITE_URL=""
ARG NEXT_PUBLIC_PAYMENT_ASSETS_JSON=""
ARG NEXT_PUBLIC_OPERATOR_LEGAL_NAME=""
ARG NEXT_PUBLIC_OPERATOR_LEGAL_FORM=""
ARG NEXT_PUBLIC_OPERATOR_SHARE_CAPITAL=""
ARG NEXT_PUBLIC_OPERATOR_REGISTERED_OFFICE=""
ARG NEXT_PUBLIC_OPERATOR_REGISTRY_ID=""
ARG NEXT_PUBLIC_OPERATOR_CONTACT_EMAIL=""
ARG NEXT_PUBLIC_OPERATOR_PUBLICATION_DIRECTOR=""
ARG NEXT_PUBLIC_OPERATOR_HOSTING_PROVIDER=""
ARG NEXT_PUBLIC_LEGAL_GOVERNING_LAW=""
ARG NEXT_PUBLIC_LEGAL_JURISDICTION=""
ARG NEXT_PUBLIC_LEGAL_SUPERVISORY_AUTHORITY=""
ARG NEXT_PUBLIC_LEGAL_MINIMUM_AGE=""
ARG NEXT_PUBLIC_LEGAL_EFFECTIVE_DATE=""
ARG NEXT_PUBLIC_LEGAL_RESPONSE_WINDOW=""
ARG LEGAL_PUBLISH_MODE=""
ARG IMAGE_OPTIMIZER_MINIMUM_CACHE_TTL=""
ARG IMAGE_OPTIMIZER_SHARP_CONCURRENCY=""

ENV NEXT_PUBLIC_ZERODEV_PROJECT_ID=$NEXT_PUBLIC_ZERODEV_PROJECT_ID
ENV NEXT_PUBLIC_API_URL=$NEXT_PUBLIC_API_URL
ENV NEXT_PUBLIC_CHAIN_ID=$NEXT_PUBLIC_CHAIN_ID
ENV NEXT_PUBLIC_EXPLORER_URL=$NEXT_PUBLIC_EXPLORER_URL
ENV NEXT_PUBLIC_STEM_NFT_ADDRESS=$NEXT_PUBLIC_STEM_NFT_ADDRESS
ENV NEXT_PUBLIC_MARKETPLACE_ADDRESS=$NEXT_PUBLIC_MARKETPLACE_ADDRESS
ENV NEXT_PUBLIC_TRANSFER_VALIDATOR_ADDRESS=$NEXT_PUBLIC_TRANSFER_VALIDATOR_ADDRESS
ENV NEXT_PUBLIC_CONTENT_PROTECTION_ADDRESS=$NEXT_PUBLIC_CONTENT_PROTECTION_ADDRESS
ENV NEXT_PUBLIC_DISPUTE_RESOLUTION_ADDRESS=$NEXT_PUBLIC_DISPUTE_RESOLUTION_ADDRESS
ENV NEXT_PUBLIC_CURATION_REWARDS_ADDRESS=$NEXT_PUBLIC_CURATION_REWARDS_ADDRESS
ENV NEXT_PUBLIC_SHOW_CAMPAIGN_ESCROW_ADDRESS=$NEXT_PUBLIC_SHOW_CAMPAIGN_ESCROW_ADDRESS
ENV NEXT_PUBLIC_RPC_URL=$NEXT_PUBLIC_RPC_URL
ENV NEXT_PUBLIC_AA_BUNDLER=$NEXT_PUBLIC_AA_BUNDLER
ENV NEXT_PUBLIC_PIMLICO_API_KEY=$NEXT_PUBLIC_PIMLICO_API_KEY
ENV NEXT_PUBLIC_PASSKEY_SERVER_URL=$NEXT_PUBLIC_PASSKEY_SERVER_URL
ENV NEXT_PUBLIC_PASSKEY_RP_ID=$NEXT_PUBLIC_PASSKEY_RP_ID
ENV NEXT_PUBLIC_ENV=$NEXT_PUBLIC_ENV
ENV NEXT_PUBLIC_SITE_URL=$NEXT_PUBLIC_SITE_URL
ENV NEXT_PUBLIC_PAYMENT_ASSETS_JSON=$NEXT_PUBLIC_PAYMENT_ASSETS_JSON
ENV NEXT_PUBLIC_OPERATOR_LEGAL_NAME=$NEXT_PUBLIC_OPERATOR_LEGAL_NAME
ENV NEXT_PUBLIC_OPERATOR_LEGAL_FORM=$NEXT_PUBLIC_OPERATOR_LEGAL_FORM
ENV NEXT_PUBLIC_OPERATOR_SHARE_CAPITAL=$NEXT_PUBLIC_OPERATOR_SHARE_CAPITAL
ENV NEXT_PUBLIC_OPERATOR_REGISTERED_OFFICE=$NEXT_PUBLIC_OPERATOR_REGISTERED_OFFICE
ENV NEXT_PUBLIC_OPERATOR_REGISTRY_ID=$NEXT_PUBLIC_OPERATOR_REGISTRY_ID
ENV NEXT_PUBLIC_OPERATOR_CONTACT_EMAIL=$NEXT_PUBLIC_OPERATOR_CONTACT_EMAIL
ENV NEXT_PUBLIC_OPERATOR_PUBLICATION_DIRECTOR=$NEXT_PUBLIC_OPERATOR_PUBLICATION_DIRECTOR
ENV NEXT_PUBLIC_OPERATOR_HOSTING_PROVIDER=$NEXT_PUBLIC_OPERATOR_HOSTING_PROVIDER
ENV NEXT_PUBLIC_LEGAL_GOVERNING_LAW=$NEXT_PUBLIC_LEGAL_GOVERNING_LAW
ENV NEXT_PUBLIC_LEGAL_JURISDICTION=$NEXT_PUBLIC_LEGAL_JURISDICTION
ENV NEXT_PUBLIC_LEGAL_SUPERVISORY_AUTHORITY=$NEXT_PUBLIC_LEGAL_SUPERVISORY_AUTHORITY
ENV NEXT_PUBLIC_LEGAL_MINIMUM_AGE=$NEXT_PUBLIC_LEGAL_MINIMUM_AGE
ENV NEXT_PUBLIC_LEGAL_EFFECTIVE_DATE=$NEXT_PUBLIC_LEGAL_EFFECTIVE_DATE
ENV NEXT_PUBLIC_LEGAL_RESPONSE_WINDOW=$NEXT_PUBLIC_LEGAL_RESPONSE_WINDOW
ENV LEGAL_PUBLISH_MODE=$LEGAL_PUBLISH_MODE
ENV IMAGE_OPTIMIZER_MINIMUM_CACHE_TTL=$IMAGE_OPTIMIZER_MINIMUM_CACHE_TTL
ENV IMAGE_OPTIMIZER_SHARP_CONCURRENCY=$IMAGE_OPTIMIZER_SHARP_CONCURRENCY

# Build Next.js with standalone output
ENV NEXT_TELEMETRY_DISABLED=1
RUN npm run build

# ---- Stage 3: Production Runtime ----
FROM node:24-alpine@sha256:d32cdf619f63fe0471182d08996dd516c6275bb5fd31ae06e55a570bd9e1ad43
WORKDIR /app

ENV NODE_ENV=production
ENV NEXT_TELEMETRY_DISABLED=1
ENV PORT=3000
ENV HOSTNAME=0.0.0.0

# Copy standalone server + static assets
COPY --from=build /app/.next/standalone ./
COPY --from=build /app/.next/static ./.next/static
COPY --from=build /app/public ./public

EXPOSE 3000

USER node

CMD ["node", "server.js"]
