config {
  type: "assertion",
  tags: ["agent_taste", "serving_contract"],
  dependencies: [require("includes/agent_taste_config").scoresTableName(dataform.projectConfig)]
}

SELECT
  *
FROM ${ref(require("includes/agent_taste_config").scoresTableName(dataform.projectConfig))}
WHERE user_id IS NULL
   OR track_id IS NULL
   OR recommendation_score IS NULL
   OR updated_at IS NULL
