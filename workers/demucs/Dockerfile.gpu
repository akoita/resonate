# GPU-enabled Demucs worker using NVIDIA CUDA
# Use via the GPU-enabled local infrastructure stack in resonate-iac

FROM pytorch/pytorch:2.3.1-cuda12.1-cudnn8-runtime@sha256:fc47f8018254e6df30f48c48f2db1c758d44de21a8c553de1a1c451a65baa70a

# Build argument to control model pre-caching
ARG CACHE_MODEL=1

# Prevent interactive prompts during apt-get
ENV DEBIAN_FRONTEND=noninteractive
ENV TZ=UTC

# Install system dependencies
RUN apt-get update && apt-get install -y \
    ffmpeg \
    libsndfile1 \
    libchromaprint-tools \
    git \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Install the CUDA-base graph without replacing the base-provided Torch ABI.
# soundfile is a reviewed input in requirements-gpu.in rather than an
# untracked command-line addition.
COPY requirements-build.lock requirements-gpu.lock constraints-gpu.txt patch_demucs.py ./
RUN python -m pip install --no-cache-dir --require-hashes -r requirements-build.lock \
    && python -m pip install --no-cache-dir --require-hashes --no-deps --no-build-isolation \
        --constraint constraints-gpu.txt -r requirements-gpu.lock \
    && python patch_demucs.py

# Create models directory
RUN mkdir -p /root/.cache/torch/hub/checkpoints

# Pre-download the Demucs model (~1GB) during build
RUN if [ "$CACHE_MODEL" = "1" ]; then \
    echo "Pre-caching Demucs htdemucs_6s model..." && \
    python -c "from demucs.pretrained import get_model; get_model('htdemucs_6s')" && \
    echo "Model cached successfully!"; \
    else echo "Skipping model cache (CACHE_MODEL=0)"; fi

COPY . .

# Ensure the output directory exists and is writable
RUN mkdir -p /outputs && chmod 777 /outputs

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=60s --retries=3 \
    CMD python -c "import urllib.request; urllib.request.urlopen('http://localhost:8000/health')" || exit 1

EXPOSE 8000

# Set CUDA device visibility
ENV NVIDIA_VISIBLE_DEVICES=all
ENV NVIDIA_DRIVER_CAPABILITIES=compute,utility
# Enable torchaudio backend dispatcher for 2.x compatibility
ENV TORCHAUDIO_USE_BACKEND_DISPATCHER=1

CMD ["uvicorn", "main:app", "--host", "0.0.0.0", "--port", "8000"]
